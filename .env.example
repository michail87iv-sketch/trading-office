# Telegram
TG_BOT_TOKEN=
TG_CHAT_ID=          # supergroup id (negative number, e.g. -1001234567890)
TG_TOPIC_SIGNALS=    # message_thread_id for #signals
TG_TOPIC_TRADES=     # message_thread_id for #trades
TG_TOPIC_REPORTS=    # message_thread_id for #reports
TG_TOPIC_ALERTS=     # message_thread_id for #alerts
TG_TOPIC_ADMIN=      # message_thread_id for #admin

# MEXC
MEXC_API_KEY=
MEXC_API_SECRET=

# Webhook (TradingView signal receiver)
WEBHOOK_PORT=3001
WEBHOOK_SECRET=          # set this in TradingView alert headers: x-webhook-secret: <value>
